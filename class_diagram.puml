' #####################################################################
'  BACKEND :: APPLICATION / CONFIG / SCHEDULING
' #####################################################################
package "backend.app & config" <<Rectangle>> {
  class StuddictApplication <<config>> {
    <<@SpringBootApplication, @EnableScheduling>>
    + main(args)
  }
  class LoanExpiryScheduler <<config>> {
    <<@Component, @Scheduled(60s)>>
    + revokeExpiredLoans()
  }
  class DataInitializer <<config>> {
    <<seeds venues/tables/students/menu>>
    ' also uses JdbcTemplate for DB sanitisation
  }
  class EBookDataInitializer <<config>> {
    <<seeds ebooks + licenses>>
  }
}
LoanExpiryScheduler ..> EBookService : every 60s
DataInitializer ..> RepoPkg : seeds on startup
EBookDataInitializer ..> EBookRepository : seeds on startup
EBookDataInitializer ..> EBookLicenseRepository : seeds on startup


' #####################################################################
'  BACKEND :: DTOs (request / response payloads)
' #####################################################################
package "backend.dto  (request / response payloads)" <<Rectangle>> {
  class RegisterRequest <<dto>> {
    firstName, lastName, email,
    password, university, department
  }
  class LoginRequest <<dto>> {
    email, password
  }
  class ReservationRequestDTO <<dto>> {
    studentId, tableId, date, time,
    duration, minCapacity, numberOfPeople, subjectName
  }
  class CheckInRequestDTO <<dto>> {
    reservationId, studentId, qrData
  }
  class CheckInResponseDTO <<dto>> {
    successful, status, message, checkInId
  }
  class OrderRequest <<dto>> {
    tableId, items : List<OrderItemRequest>
  }
  class OrderItemRequest <<dto>> {
    menuItemId, quantity
  }
}

note bottom of OrderItemRequest
  EBookCatalogDTO, EBookContentDTO and EBookLoanDTO
  live in the **model** package (not dto).
  They are shown above alongside the JPA entities.
end note


' #####################################################################
'  ANDROID CLIENT
' #####################################################################
package "android-app  (com.studdict.mobile)" <<Rectangle>> {

  class ApiClient <<network>> {
    + {static} BASE_URL : String = "http://10.0.2.2:8080/"
    - {static} api : StuddictApi
    + {static} getApi() : StuddictApi
  }

  interface StuddictApi <<network>> {
    .. Auth (UC11/UC12) ..
    + registerStudent(RegisterRequest) : Call<Student>
    + loginStudent(LoginRequest) : Call<Student>
    .. Tables & matchmaking (UC1/UC2) ..
    + getAvailableTables(..)
    + getMatchmakingTables(.., date, time, dur, minCap)
    + lockTable(id) + unlockTable(id)
    .. Reservations (UC1/UC2/UC4) ..
    + createPrivateReservation + createPublicReservation
    + joinPublicReservation + modifyReservation
    + getStudentReservations + getPublishedReservations
    .. Invite codes (UC3) ..
    + generateInviteCode + validateInviteCode + joinReservationWithInviteCode
    .. Check-in (UC5) ..
    + validateCheckIn + getCheckInParticipants + confirmCheckIn + performCheckIn
    .. Gamification (UC9) ..
    + getWallet + validatePoints + redeemPoints + earnPoints + getPointsHistory
    .. E-books (UC7) ..
    + getCatalog + executeSearch + checkEBookAvailability + getBookContent
    + requestLoan + getLoanStatus + requestReturn + getActiveLoans + notifyCheckout
    .. F&B orders (UC8) ..
    + readCatalog + addCartItem + getOrderItemsByTable
    + processSummary + createOrder + cancelOrder + getKitchenOrders
    .. Bills & payments (UC6) ..
    + getBillByTable + processPayment + splitBill
  }

  class SessionManager <<network>> {
    - pref : SharedPreferences
    + saveStudentProfile(..)
    + getStudentId() : String
    + getFirstName() : String
    + getLastName() : String
    + getEmail() : String
    + getUniversity() : String
    + getDepartment() : String
    + setCheckIn(checkInId, tableId)
    + getCheckInId() : long
    + getTableId() : int
    + clearCheckIn() + clearProfile()
    + isLoggedIn() : boolean
  }

  package "ui  (Activities, one per screen)" as UiPkg <<Rectangle>> {
    class ScreenLogin <<activity>>
    class ScreenRegister <<activity>>
    class ScreenVenues <<activity>>
    class ScreenProfile <<activity>>
    class ScreenTables <<activity>>
    class ScreenForm <<activity>>
    class ScreenConfirm <<activity>>
    class ScreenMyBookings <<activity>>
    class ScreenReservationDetails <<activity>>
    class ScreenInviteCodeInput <<activity>>
    class ScreenCheckIn <<activity>>
    class ScreenCheckInSuccess <<activity>>
    class ScreenLiveBoard <<activity>>
    class ScreenEBookVault <<activity>>
    class ScreenEBookReader <<activity>>
    class ScreenOrderMenu <<activity>>
    class ScreenOrderSummary <<activity>>
    class ScreenKitchenOrders <<activity>>
    class ScreenBill <<activity>>
    class ScreenPayment <<activity>>
  }

  note bottom of UiPkg
    Each Screen extends android.app.Activity.
    All screens call ApiClient.getApi() for REST access and
    use SessionManager for studentId / active check-in state.
    Gson model DTOs (com.studdict.mobile.model, 36 classes:
    Student, StudyTable, Reservation, PublicReservation, InviteCode,
    CheckIn, EBook, MenuItem, Order, Bill, LoyaltyWallet, PointsTransaction,
    plus LoginRequest / RegisterRequest / PaymentRequest ...) mirror backend JSON.
  end note
}

ApiClient ..> StuddictApi : <<creates (Retrofit)>>
ScreenLogin ..> ApiClient
ScreenLogin ..> SessionManager
ScreenEBookReader ..> ApiClient
ScreenBill ..> SessionManager

StuddictApi ..> CtrlPkg : HTTP / JSON (REST)

@enduml