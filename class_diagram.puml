' #####################################################################
'  BACKEND :: REST CONTROLLER LAYER (@RestController)
' #####################################################################
package "backend.controller  (@RestController)" as CtrlPkg <<Rectangle>> {

  class StudentController <<controller>> {
    /api/students
    + register(RegisterRequest)
    + login(LoginRequest)
  }
  class StudyTableController <<controller>> {
    /api/tables
    + available(..) + matchmaking(.., date, time, dur, minCap)
    + lock(tableId) + unlock(tableId)
  }
  class ReservationController <<controller>> {
    /api/reservations
    + private(..) + public(..)
    + join(id) + delete(id) + byStudent(id)
  }
  class ReservationUpdateController <<controller>> {
    /api/reservations
    + modify(id, ReservationUpdateRequest)
  }
  class InviteCodeController <<controller>> {
    /invite-code
    + generate + validate + join + join-result
  }
  class CheckInController <<controller>> {
    /check-in
    + validate + participants + confirm + perform
  }
  class EBookController <<controller>> {
    /api/ebooks
    + access + search + catalog + content
    + loan + loanStatus + return + revoke
    + loans/active + loans/session + notify-checkout
  }
  class GamificationController <<controller>> {
    /api/gamification
    + wallet(id) + validate + earn + redeem + history(id)
  }
  class OrderController <<controller>> {
    /api/orders
    + catalog + create + cancel
    + cart/add + summary + kitchen/active
    + getOrderItemsByTable(tableId)
  }
  class LiveBoardController <<controller>> {
    /api/liveboard
    + published()
  }
  class BillLookupController <<controller>> {
    /api/bills
    + getByTable(tableId)  ' auto-creates empty bill
  }
  class PaymentController <<controller>> {
    /payments
    + process(PaymentRequest) + split(SplitRequest)
  }

  together {
    class BillCalculationController <<controller>> {
      /checkout :: + generate(resId)
    }
    class CancellationController <<controller>> {
      /cancellation :: + cancel(resId)
    }
    class CashPaymentController <<controller>> {
      /payment/cash :: + accept(..)
    }
    class TransactionProcessingController <<controller>> {
      /payment/transaction :: + process(..)
    }
    class SplitBillController <<controller>> {
      /payment/split :: + calculate(..)
    }
    class CompletionAndRewardController <<controller>> {
      /payment/completion :: + summary(billId)
    }
    class FailureManagementController <<controller>> {
      /payment/failure :: + report(..)
    }
    class TimeoutManagementController <<controller>> {
      /payment/timeout :: + check(billId)
    }
    class AvailabilityCheckController <<controller>> {
      /availability :: + tables(..)
    }
  }
}

note bottom of AvailabilityCheckController
  The "/payment/*", "/checkout", "/cancellation" and "/availability"
  controllers are an alternative endpoint set; the live Android client
  uses the "/api/*", "/payments", "/check-in" and "/invite-code" ones.
end note

