@startuml Studdict_Class_Diagram
title Studdict — Class Diagram\n(Spring Boot REST backend + Android / Retrofit client)

' =====================================================================
'  STYLE
' =====================================================================
skinparam shadowing false
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam classFontStyle bold
skinparam packageStyle rectangle
hide circle

skinparam class {
    BackgroundColor<<entity>>      #FDF6E3
    BorderColor<<entity>>          #B58900
    BackgroundColor<<repository>>  #E8F0FE
    BorderColor<<repository>>      #3366CC
    BackgroundColor<<service>>     #E6F4EA
    BorderColor<<service>>         #2E7D32
    BackgroundColor<<controller>>  #FCE8E6
    BorderColor<<controller>>      #C5221F
    BackgroundColor<<config>>      #F3E8FD
    BorderColor<<config>>          #8E24AA
    BackgroundColor<<dto>>         #F5F5F5
    BorderColor<<dto>>             #9E9E9E
    BackgroundColor<<activity>>    #EDE7F6
    BorderColor<<activity>>        #5E35B1
    BackgroundColor<<network>>     #FFF3E0
    BorderColor<<network>>         #EF6C00
}

legend top left
  Studdict — collaborative study-space platform
  Backend: Spring Boot 3.2 + Spring Data JPA (H2/MySQL), layered Controller -> Service -> Repository -> Entity
  Client : Android (java) using Retrofit2 + Gson, one Activity ("Screen*") per UI screen
  Note: entity "status / role / visibility / paymentMethod" fields are plain Strings (no DB enums)
endlegend


' #####################################################################
'  BACKEND :: DOMAIN MODEL (JPA ENTITIES)
' #####################################################################
package "backend.model  (JPA Entities)" <<Rectangle>> {

  class Student <<entity>> {
    - studentId : String  <<PK>>
    - firstName : String
    - lastName : String
    - email : String  <<unique>>
    - password : String
    - university : String
    - department : String
  }

  class Venue <<entity>> {
    - venueId : Long  <<PK>>
    - name : String
    - address : String
    - type : String
    - isActive : boolean
    - tables : List<StudyTable>
  }

  class StudyTable <<entity>> {
    - tableId : int  <<PK>>
    - tableNumber : int
    - capacity : int
    - qrCodeString : String
    - isAvailable : boolean
    - softLockedBy : String
    - softLockExpiration : LocalTime
    - venue : Venue
  }

  class StudySubject <<entity>> {
    - subjectId : Long  <<PK>>
    - name : String  <<unique>>
  }

  abstract class Reservation <<entity>> {
    - reservationId : Long  <<PK>>
    - reservationDate : LocalDate
    - startTime : LocalTime
    - durationMinutes : int
    - numberOfPeople : int
    - status : String
    # visibility : String
    - table : StudyTable
    .. JPA: @Inheritance(JOINED), @DiscriminatorColumn("reservation_type") ..
  }

  class PrivateReservation <<entity>> {
    - linkedQrCode : String
  }

  class PublicReservation <<entity>> {
    - studySubject : StudySubject
  }

  class ReservationParticipant <<entity>> {
    - id : Long  <<PK>>
    - studentId : String
    - reservationId : Long
    - role : String  ' Host | Guest
    - checkedIn : boolean
  }

  class InviteCode <<entity>> {
    - inviteCodeId : Long  <<PK>>
    - code : String  <<unique>>
    - createdAt : LocalDateTime
    - expiresAt : LocalDateTime
    - active : boolean
    - reservation : Reservation
    - host : Student
    + isExpired() : boolean
    + isValid() : boolean
  }

  class CheckIn <<entity>> {
    - checkInId : Long  <<PK>>
    - checkInTime : LocalDateTime
    - scannedQrCode : String
    - successful : boolean
    - reservation : Reservation
    - table : StudyTable
    - student : Student
  }

  class EBook <<entity>> {
    - eBookId : Long  <<PK>>
    - title : String
    - author : String
    - isbn : String
    - category : String
    - content : String  <<TEXT>>
    - licenses : List<EBookLicense>
  }

  class EBookLicense <<entity>> {
    - licenseId : Long  <<PK>>
    - isAvailable : boolean
    - ebook : EBook
  }

  class EBookLoan <<entity>> {
    - loanId : Long  <<PK>>
    - startTime : LocalDateTime
    - endTime : LocalDateTime
    - isActive : boolean
    - license : EBookLicense
    - checkIn : CheckIn
  }

  class LoyaltyWallet <<entity>> {
    - studentId : String  <<PK>>
    - totalBalance : int = 100
    - minimumRedeemLimit : int = 25
    - exchangeRate : double = 0.03
  }

  class PointsTransaction <<entity>> {
    - transactionId : String  <<PK,UUID>>
    - studentId : String
    - pointsAmount : int
    - transactionType : String  ' EARN | REDEEM
    - timestamp : LocalDateTime
    - description : String
  }

  class MenuItem <<entity>> {
    - itemId : Long  <<PK>>
    - name : String
    - price : double
    - isAvailable : boolean
    - category : String
  }

  class Order <<entity>> {
    - orderId : Long  <<PK>>
    - status : String  ' PREPARING ...
    - totalAmount : double
    - placedAt : LocalDateTime
    - items : List<OrderItem>
    - table : StudyTable
    .. JPA: @Table(name = "orders") ..
  }

  class OrderItem <<entity>> {
    - orderItemId : Long  <<PK>>
    - quantity : int
    - subTotal : double
    - menuItem : MenuItem
    - order : Order
  }

  class Bill <<entity>> {
    - billId : Long  <<PK>>
    - reservationId : Long
    - tableId : Integer
    - totalAmount : double
    - discountAmount : Double = 0.0
    - issueTime : LocalDateTime
    - isSettled : boolean
  }

  class Payment <<entity>> {
    - paymentId : String  <<PK,UUID>>
    - reservationId : String
    - amountPaid : double
    - paymentMethod : String
    - timestamp : LocalDateTime
    - status : String
  }
}

' ---- Entity relationships ----------------------------------------
Reservation <|-- PrivateReservation
Reservation <|-- PublicReservation

Venue "1" *-- "0..*" StudyTable : tables
StudyTable "0..*" --> "1" Venue : venue
Reservation "0..*" --> "1" StudyTable : table
PublicReservation "0..*" --> "0..1" StudySubject : subject

InviteCode "0..*" --> "1" Reservation
InviteCode "0..*" --> "1" Student : host

CheckIn "0..*" --> "1" Reservation
CheckIn "0..*" --> "1" StudyTable
CheckIn "0..*" --> "1" Student

EBook "1" *-- "0..*" EBookLicense : licenses
EBookLoan "0..*" --> "1" EBookLicense
EBookLoan "0..*" --> "1" CheckIn

Order "1" *-- "1..*" OrderItem : items
OrderItem "0..*" --> "1" MenuItem
Order "0..*" --> "1" StudyTable : table

' ---- "soft" references (id fields, no JPA FK) --------------------
ReservationParticipant ..> Reservation : <<by reservationId>>
ReservationParticipant ..> Student : <<by studentId>>
Bill ..> Reservation : <<by reservationId>>
Bill ..> StudyTable : <<by tableId>>
Bill ..> Payment : <<settled by reservationId>>
Student ..> LoyaltyWallet : <<shared id (studentId)>>
PointsTransaction ..> LoyaltyWallet : <<by studentId>>


' #####################################################################
'  BACKEND :: REPOSITORY LAYER (Spring Data JPA)
' #####################################################################
package "backend.repository  (Spring Data JPA)" as RepoPkg <<Rectangle>> {

  interface StudentRepository <<repository>> {
    JpaRepository<Student, String>
    + findByEmail(email) : Optional<Student>
  }
  interface VenueRepository <<repository>> {
    JpaRepository<Venue, Long>
    + findByIsActiveTrue() : List<Venue>
  }
  interface StudyTableRepository <<repository>> {
    JpaRepository<StudyTable, Integer>
    + findByVenue_VenueId(id) : List
    + findByVenue_VenueIdAndIsAvailableTrue(id)
    + findByQrCodeString(qr) : Optional
  }
  interface SubjectRepository <<repository>> {
    JpaRepository<StudySubject, Long>
    + findByNameIgnoreCase(name) : Optional
  }
  interface ReservationRepository <<repository>> {
    JpaRepository<Reservation, Long>
    + findByTable_TableIdAndStatus(..)
    + findByVisibilityAndStatus(..)
    + findActiveReservationsByStudent(id)
    + findMatchmakingReservations(venueId, subj)
  }
  interface ParticipantRepository <<repository>> {
    JpaRepository<ReservationParticipant, Long>
    + countByReservationId(id) : long
    + findByReservationId(id) : List
    + findByIdIn(ids) : List
    + findByReservationIdAndStudentId(..)
  }
  interface InviteCodeRepository <<repository>> {
    JpaRepository<InviteCode, Long>
    + findByCode(code) : InviteCode
    + findFirstByReservation_..OrderByCreatedAtAsc(id)
  }
  interface CheckInRepository <<repository>> {
    JpaRepository<CheckIn, Long>
    + findByReservation_ReservationId(id) : List
  }
  interface EBookRepository <<repository>> {
    JpaRepository<EBook, Long>
  }
  interface EBookLicenseRepository <<repository>> {
    JpaRepository<EBookLicense, Long>
  }
  interface EBookLoanRepository <<repository>> {
    JpaRepository<EBookLoan, Long>
    + findActiveLoansByCheckIn(checkInId) : List
    + findAllByCheckIn_CheckInId(checkInId) : List
    + findByIsActiveTrue() : List
  }
  interface LoyaltyWalletRepository <<repository>> {
    JpaRepository<LoyaltyWallet, String>
  }
  interface PointsTransactionRepository <<repository>> {
    JpaRepository<PointsTransaction, String>
    + findByStudentIdOrderByTimestampDesc(id)
  }
  interface MenuItemRepository <<repository>> {
    JpaRepository<MenuItem, Long>
  }
  interface OrderRepository <<repository>> {
    JpaRepository<Order, Long>
    + findByStatus(status) : List
    + findByTable_TableId(tableId) : List
  }
  interface OrderItemRepository <<repository>> {
    JpaRepository<OrderItem, Long>
  }
  interface BillRepository <<repository>> {
    JpaRepository<Bill, Long>
    + findByReservationId(id) : Optional
    + findTopByTableIdOrderByIssueTimeDesc(tableId)
  }
  interface PaymentRepository <<repository>> {
    JpaRepository<Payment, String>
  }
}


' #####################################################################
'  BACKEND :: SERVICE LAYER (business logic)
' #####################################################################
package "backend.service  (@Service)" <<Rectangle>> {

  class StudentService <<service>> {
    + registerStudent(..) : Student
    + loginStudent(email, pwd) : Student
  }
  class VenueService <<service>> {
    + findActiveVenues() : List<Venue>
    + fetchVenues(id) : Venue
  }
  class SubjectService <<service>> {
    + findOrCreate(name) : StudySubject
  }
  class StudyTableService <<service>> {
    + getAvailableTables(..) : List<StudyTable>
    + findMatchmakingTables(venueId, subj, date, time, dur, minCap)
    + requestSoftLock(tableId, studentId) : boolean
    + releaseSoftLock(tableId)
  }
  class ReservationService <<service>> {
    + savePrivateReservation(..) : Long
    + savePublicReservation(..) : Long
    + joinPublicReservation(resId, studentId)
    + discardReservation(resId)
    + getPublishedReservations() : List
    + getReservationsByStudent(id) : List
  }
  class ReservationUpdateService <<service>> {
    + modifyReservation(id, time, dur, cap) : Reservation
  }
  class InviteCodeService <<service>> {
    + generateInviteCode(resId, hostId) : InviteCode
    + validateCode(code) : boolean
    + joinReservationWithResult(code, guestId) : JoinReservationResult
    + checkAvailability(resId) : boolean
  }
  class CheckInService <<service>> {
    + identifyTable(qr) : StudyTable
    + validateReservation(resId, qr) : ReservationValidationResult
    + getParticipants(resId) : List
    + updateCheckedInStatus(participantIds) : List
    + associateParticipants(participantIds) : boolean
    + activateServices(participants) : boolean
    + confirmCheckInParticipants(..) : CheckInResponseDTO
    + checkInParticipants(..) : List<CheckIn>
    + performCheckIn(resId, studentId, qr) : CheckInResponseDTO
    + checkInStudent(res, student, qr) : CheckIn
  }
  class EBookService <<service>> {
    + requestAccess(checkInId) : boolean
    + getCatalog(keyword) : List<EBookCatalogDTO>
    + executeSearch(keyword) : List<EBook>
    + checkAvailability(ebookId) : EBookLicense
    + requestLoan(checkInId, ebookId) : EBookLoan
    + getBookContent(ebookId) : EBookContentDTO
    + getLoanStatus(loanId) : EBookLoan
    + checkRequest(loanId) : EBookLoan
    + releaseLoan(loan)
    + revokeLoan(checkInId)
    + revokeExpiredLoans()
  }
  class GamificationService <<service>> {
    + getWallet(studentId) : LoyaltyWallet
    + creditPointsForStudy(studentId, resId) : int
    + redeemPoints(studentId, pts, tableId) : boolean
    + calculateDiscount(pts) : double
    + applyDiscountToBill(tableId, discount)
    + getPointsHistory(studentId) : List
  }
  class OrderService <<service>> {
    + readCatalog() : List<MenuItem>
    + addCartItem(itemId, qty) : boolean
    + createOrder(tableId, items) : Order
    + getActiveOrders() : List<Order>
    + getOrderItemsAsStrings(tableId) : List<String>
    + calculateCost(order)
  }
  class BillCalculationService <<service>> {
    + generateBillForReservation(resId) : Bill
  }
  class PaymentService <<service>> {
    + processPayment(billId, method, amount) : Bill
    + calculateSplitAmount(billId, n) : double
  }
}

