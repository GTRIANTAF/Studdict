<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingBottom="104dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="28dp"
            android:paddingEnd="24dp"
            android:paddingBottom="124dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/backButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:text="&lt;"
                    android:textColor="#000000"
                    android:textSize="46sp" />

                <TextView
                    android:id="@+id/headerTitle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="CEID LIBRARY"
                    android:textColor="#000000"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="48dp"
                    android:layout_height="48dp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:text="Reservation Details"
                android:textColor="#000000"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                style="@style/ReservationSectionLabel"
                android:text="Date" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/todayButton"
                    style="@style/ReservationChip"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="Today" />

                <Button
                    android:id="@+id/tomorrowButton"
                    style="@style/ReservationChip"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="Tomorrow" />

                <Button
                    android:id="@+id/thirdDateButton"
                    style="@style/ReservationChip"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="Thu, 31" />
            </LinearLayout>

            <TextView
                style="@style/ReservationSectionLabel"
                android:text="Time &amp; Duration" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/timeButton"
                    style="@style/ReservationChip"
                    android:layout_width="0dp"
                    android:layout_marginEnd="28dp"
                    android:layout_weight="1"
                    android:text="10:00 AM  v" />

                <Button
                    android:id="@+id/durationButton"
                    style="@style/ReservationChip"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="2 Hours  v" />
            </LinearLayout>

            <TextView
                style="@style/ReservationSectionLabel"
                android:layout_gravity="center_horizontal"
                android:text="Group Size" />

            <LinearLayout
                android:layout_width="140dp"
                android:layout_height="52dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:background="@drawable/stepper"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/decreaseGroupButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="-"
                    android:textColor="#000000"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/groupSizeText"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="#000000"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/increaseGroupButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="#000000"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/privateChoiceCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="34dp"
                android:background="@drawable/choice_selected"
                android:orientation="horizontal"
                android:padding="18dp">

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/chip"
                    android:gravity="center"
                    android:text="P"
                    android:textColor="#6E55DC"
                    android:textSize="22sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Private Study"
                        android:textColor="#111111"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Only you and your invited peers can join this table."
                        android:textColor="#777777"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/publicChoiceCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/choice_unselected"
                android:orientation="horizontal"
                android:padding="18dp">

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/stepper"
                    android:gravity="center"
                    android:text="O"
                    android:textColor="#60646C"
                    android:textSize="22sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Public Match"
                        android:textColor="#111111"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Allow other students studying the same subject to join your table."
                        android:textColor="#777777"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>

            <EditText
                android:id="@+id/subjectInput"
                style="@style/StuddictInput"
                android:layout_marginTop="22dp"
                android:hint="Subject for public match"
                android:inputType="text"
                android:text="Mathematics"
                android:visibility="gone" />

            <Button
                android:id="@+id/searchButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/button_primary"
                android:text="Find Tables"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
                
            <LinearLayout
                android:id="@+id/joinPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="34dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Or join an existing reservation"
                    android:textColor="#000000"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/joinReservationInput"
                        style="@style/StuddictInput"
                        android:layout_width="0dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:hint="Reservation ID"
                        android:inputType="number" />
                </LinearLayout>

                <Button
                    android:id="@+id/joinPublicButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/button_secondary"
                    android:text="Join Table"
                    android:textAllCaps="false"
                    android:textColor="@color/studdict_text"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bottom_nav"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView style="@style/BottomNavItem" android:text="HOME" />
        <TextView style="@style/BottomNavItem" android:text="BOOKING" android:textStyle="bold" />
        <TextView style="@style/BottomNavItem" android:text="ORDER" />
        <TextView style="@style/BottomNavItem" android:text="WALLET" />
        <TextView style="@style/BottomNavItem" android:text="PROFILE" />
    </LinearLayout>
</FrameLayout>
