<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Checkout"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="24dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/choice_unselected"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/txtBillId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bill #—"
                android:textSize="18sp"
                android:textColor="#111111"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/txtBillTable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Table: —"
                android:textColor="#6E55DC"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="16dp"
                android:background="#EEEEEE" />

            <!-- Sleek Price Breakdown Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <!-- Original Price (Gross Subtotal) -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Original Price"
                        android:textColor="@color/studdict_muted"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/txtOriginalPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="€0.00"
                        android:textColor="@color/studdict_muted"
                        android:textSize="14sp"
                        android:layout_alignParentEnd="true" />
                </RelativeLayout>

                <!-- Applied Points Discount (Hidden unless applied/greater than 0) -->
                <RelativeLayout
                    android:id="@+id/layout_discount_line"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:visibility="gone">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Points Discount"
                        android:textColor="#FF8F00"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/txtDiscountAppliedText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-€0.00"
                        android:textColor="#FF8F00"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_alignParentEnd="true" />
                </RelativeLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E2E8F0"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="8dp" />

                <!-- Final Net Total -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total to Pay"
                        android:textColor="@color/studdict_text"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/txtBillTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="€0.00"
                        android:textColor="@color/studdict_primary_dark"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:layout_alignParentEnd="true" />
                </RelativeLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/txtBillStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status: Pending payment"
                android:textSize="13sp"
                android:textColor="@color/studdict_muted"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/tv_available_points"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Available Points: -"
                android:textSize="16sp"
                android:textColor="#FF8F00"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <!-- Premium Interactive Points Selector -->
            <LinearLayout
                android:id="@+id/layout_points_selector"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp"
                android:background="@drawable/stepper"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageButton
                    android:id="@+id/btn_points_decrement"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_minus"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Decrease points"
                    android:padding="8dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tv_selected_points"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="25 Points"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/studdict_text" />

                    <TextView
                        android:id="@+id/tv_points_discount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-0.75€ Discount"
                        android:textSize="13sp"
                        android:textColor="@color/studdict_muted" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btn_points_increment"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_plus"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Increase points"
                    android:padding="8dp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_redeem_points"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Redeem 25 Points (-0.75€)"
                android:backgroundTint="#FF8F00"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:enabled="false"/>

        </LinearLayout>

        <!-- E-Books Borrowed This Session -->
        <TextView
            android:id="@+id/txtEbookLoansHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="E-Books Borrowed This Session"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#4A148C"
            android:visibility="gone"
            android:layout_marginBottom="4dp"/>

        <LinearLayout
            android:id="@+id/ebookLoansContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp">

            <Button
                android:id="@+id/btnPayFull"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Pay Full Amount"
                android:background="@drawable/button_primary"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btnSplitBill"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Split Bill"
                android:background="@drawable/button_primary"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btnPayCash"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Pay with Cash (Staff)"
                android:backgroundTint="#FF9800"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>
                
            <Button
                android:id="@+id/btnCloseBill"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Close (Return)"
                android:backgroundTint="#9E9E9E"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>
