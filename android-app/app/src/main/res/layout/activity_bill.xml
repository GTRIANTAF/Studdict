<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Checkout"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="24dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/choice_unselected"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/txtBillId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bill #—"
                android:textSize="18sp"
                android:textColor="#111111"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/txtBillTable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Table: —"
                android:textColor="#6E55DC"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="16dp"
                android:background="#EEEEEE" />

            <TextView
                android:id="@+id/txtBillTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total: €0.00"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#6E55DC"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/txtBillStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status: Pending payment"
                android:textSize="14sp"
                android:textColor="#757575"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/tv_available_points"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Available Points: -"
                android:textSize="16sp"
                android:textColor="#FF8F00"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btn_redeem_points"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Redeem 100 Points (-3.00€)"
                android:backgroundTint="#FF8F00"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:enabled="false"/>

        </LinearLayout>

        <!-- E-Books Borrowed This Session -->
        <TextView
            android:id="@+id/txtEbookLoansHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="E-Books Borrowed This Session"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#4A148C"
            android:visibility="gone"
            android:layout_marginBottom="4dp"/>

        <LinearLayout
            android:id="@+id/ebookLoansContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp">

            <Button
                android:id="@+id/btnPayFull"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Pay Full Amount"
                android:background="@drawable/button_primary"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btnSplitBill"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Split Bill"
                android:background="@drawable/button_primary"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btnPayCash"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Pay with Cash (Staff)"
                android:backgroundTint="#FF9800"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>
                
            <Button
                android:id="@+id/btnCloseBill"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Close (Return)"
                android:backgroundTint="#9E9E9E"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>
