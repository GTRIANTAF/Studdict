<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:background="?android:attr/selectableItemBackground">

    <!-- Transaction Icon Container -->
    <TextView
        android:id="@+id/txIcon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/chip"
        android:gravity="center"
        android:text="🟢"
        android:textSize="14sp" />

    <!-- Details Container -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Study Reward"
            android:textColor="@color/studdict_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Table 2, CEID Library (120 mins stay)"
            android:textColor="@color/studdict_muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/txTimestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="2026-05-30 18:48"
            android:textColor="@color/studdict_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Points Amount Container -->
    <TextView
        android:id="@+id/txAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="+50 pts"
        android:textColor="@color/studdict_success"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
