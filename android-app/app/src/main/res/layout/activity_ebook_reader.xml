<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/txtReaderTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Book Title"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <ScrollView
        android:id="@+id/scrollReader"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/txtReaderContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Book content goes here..."
            android:lineSpacingMultiplier="1.2"
            android:textSize="16sp" />
    </ScrollView>

    <!-- Page navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btnPrevPage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="‹ Prev" />

        <TextView
            android:id="@+id/txtPageIndicator"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Page 1 / 1"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnNextPage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Next ›" />
    </LinearLayout>

    <Button
        android:id="@+id/btnReturnBook"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Return E-Book"
        android:backgroundTint="#D32F2F"/>
</LinearLayout>